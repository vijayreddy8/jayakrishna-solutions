# Frontend-safe Supabase values (safe to expose only the anon/publishable key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Never use NEXT_PUBLIC_ for secrets.
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit server credentials. Keep secret on server only.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Server-side speech/translation provider adapter credentials (optional in demo)
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=

# Optional Razorpay integration (not enabled until server webhook verification is implemented)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
